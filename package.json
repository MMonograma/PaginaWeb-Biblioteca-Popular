{
  "name": "biblioteca-popular",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de la Biblioteca Popular",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "watch": "npm run dev",
    "serve": "npx -y serve -l 3000 public",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "build:html": "node build.js",
    "build": "npm run build:css && npm run build:html"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "type": "module"
}
